# Copy to .env on the server (optional). NEVER commit .env.
CI_ENVIRONMENT = production

# Leave this commented out and the site works on ANY domain / IP / sub-folder
# (it detects its own address). Uncomment only to force one canonical address.
# app.baseURL = 'https://www.timbindia.com/'

# Enquiry / career form e-mails. Every submission is ALWAYS saved in writable/forms/;
# set these (SMTP details from your mail host) so a copy is also e-mailed to timb@tii.murugappa.com.
# email.protocol    = smtp
# email.SMTPHost    = smtp.yourmailhost.com
# email.SMTPUser    = timb@tii.murugappa.com
# email.SMTPPass    = CHANGE_ME
# email.SMTPPort    = 587
# email.SMTPCrypto  = tls
# email.fromEmail   = timb@tii.murugappa.com

# Not used yet (no database features). Create a dedicated MySQL user - never root.
# database.default.hostname = 127.0.0.1
# database.default.database = timb_web
# database.default.username = timb_app
# database.default.password = CHANGE_ME
# database.default.DBDriver = MySQLi
