# Copy to .env on the server and fill in. NEVER commit .env.
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# Site address — REQUIRED in production
#--------------------------------------------------------------------
# Every link, image and redirect is built from this. Use https: the site then
# forces https for every request and marks its cookies secure.
app.baseURL = 'https://www.timbindia.com/'

# Other host names that may serve the site (only used if app.baseURL is left
# out). A request for any other host is not trusted to build links.
# app.allowedHostnames.0 = 'timbindia.com'

#--------------------------------------------------------------------
# Database — use a dedicated MySQL/MariaDB user, never root
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = timb_cms
database.default.username = timb_app
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# Encryption key — generate with: php spark key:generate
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# Email alerts — every enquiry and job application is emailed here
# (it is saved in the admin Inbox either way).
#
# BEFORE GOING LIVE: replace smtptest897@gmail.com (three places) with the
# real mailbox, and put that mailbox's password in email.SMTPPass.
# Then check it with Admin → Settings → Send a test email.
#--------------------------------------------------------------------
email.protocol    = smtp
email.SMTPHost    = smtp.gmail.com
email.SMTPPort    = 587
email.SMTPCrypto  = tls
email.SMTPTimeout = 15
email.SMTPUser    = smtptest897@gmail.com
# Gmail: a 16-character APP PASSWORD, not the account's normal password
# (Google Account → Security → 2-Step Verification → App passwords).
email.SMTPPass    = 'kuse estn kril lit'
email.fromEmail   = smtptest897@gmail.com
email.fromName    = 'TIMB Website'
# Who receives the alerts; several addresses separated by commas.
# Leave empty to use the contact email from Admin → Settings.
email.recipients  = smtptest897@gmail.com
